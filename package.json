{
    "name": "@prostojs/mate",
    "version": "0.5.0",
    "description": "MATE is TS Metadata Organizer",
    "keywords": [
        "decorators",
        "mate",
        "metadata",
        "prostojs"
    ],
    "homepage": "https://github.com/prostojs/mate#readme",
    "bugs": {
        "url": "https://github.com/prostojs/mate/issues"
    },
    "license": "MIT",
    "author": "Artem Maltsev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/prostojs/mate.git"
    },
    "files": [
        "dist"
    ],
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && rolldown -c rolldown.config.mjs && rm -rf dts-build",
        "release": "node ./scripts/release",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
        "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
    },
    "devDependencies": {
        "@prostojs/dye": "^0.4.9",
        "@swc/core": "^1.15.13",
        "@types/node": "^22.19.11",
        "conventional-changelog": "^3.1.25",
        "conventional-changelog-cli": "^2.2.2",
        "enquirer": "^2.4.1",
        "execa": "^5.1.1",
        "minimist": "^1.2.8",
        "oxfmt": "^0.35.0",
        "oxlint": "^1.50.0",
        "reflect-metadata": "^0.1.14",
        "rolldown": "1.0.0-rc.5",
        "rolldown-plugin-dts": "^0.22.1",
        "semver": "^7.7.4",
        "typescript": "^5.9.3",
        "unplugin-swc": "^1.5.9",
        "vitest": "^3.2.4",
        "yorkie": "^2.0.0"
    },
    "gitHooks": {
        "commit-msg": "node scripts/verifyCommit.js"
    }
}
